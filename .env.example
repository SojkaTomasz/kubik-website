# --- Podstawy strony -------------------------------------------------------
# Pełny URL produkcyjny, bez ukośnika na końcu. Używany przez metadataBase,
# canonical, sitemap.xml, robots.txt i JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analityka -------------------------------------------------------------
# ID kontenera Google Tag Managera (GTM-XXXXXXX). Puste = GTM się nie ładuje.
NEXT_PUBLIC_GTM_ID=

# Analityka Vercela — włączaj dopiero na wdrożeniu produkcyjnym.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# --- Strony deweloperskie --------------------------------------------------
# Udostępnia /dev/* w buildzie produkcyjnym (np. na preview deploy Vercela).
# Na produkcji ma pozostać false.
NEXT_PUBLIC_ENABLE_DEV_PAGES=false

# --- Kontakt ---------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@example.com
NEXT_PUBLIC_CONTACT_PHONE=+48000000000

# --- Poczta (Resend) -------------------------------------------------------
# Klucz z https://resend.com/api-keys
RESEND_API_KEY=
# Adres nadawcy musi należeć do domeny zweryfikowanej w Resend.
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Example
# Adres, na który trafiają zgłoszenia z formularza kontaktowego.
MAIL_TO=kontakt@example.com
