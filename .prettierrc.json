{
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"singleAttributePerLine": true,
	"proseWrap": "always",
	"printWidth": 100,
	"useTabs": true,
	"tabWidth": 3,
	"trailingComma": "es5",
	"endOfLine": "lf",
	"embeddedLanguageFormatting": "auto",
	"plugins": ["prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./src/app/globals.css",
	"tailwindFunctions": ["cn", "cva", "clsx", "twMerge"],
	"overrides": [
		{
			"files": ["*.yml", "*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
