# Normalizacja końców linii.
#
# Prettier jest ustawiony na `endOfLine: lf`. Bez tego pliku Git na Windowsie
# wypisywałby pliki z CRLF przy checkoucie, więc `pnpm format:check` wywalałby
# się zaraz po świeżym sklonowaniu repozytorium — na każdym pliku naraz.
* text=auto eol=lf

# Pliki binarne — Git nie może ich dotykać, bo normalizacja je uszkadza.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.pdf   binary

# Lockfile bywa ogromny — w diffach i tak się go nie czyta.
pnpm-lock.yaml -diff linguist-generated=true
